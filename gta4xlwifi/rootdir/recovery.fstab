#<src>                          <mnt_point>     <type>      <mnt_flags and options>           <fs_mgr_flags>
system                          /system         ext4        ro,barrier=1,discard              logical,first_stage_mount
system                          /system         erofs       ro,barrier=1,discard              logical,first_stage_mount
vendor                          /vendor         ext4        ro,barrier=1,discard              logical,first_stage_mount
vendor                          /vendor         erofs       ro,barrier=1,discard              logical,first_stage_mount
product                         /product        ext4        ro,barrier=1,discard              logical,first_stage_mount
product                         /product        erofs       ro,barrier=1,discard              logical,first_stage_mount
odm                             /odm            ext4        ro,barrier=1,discard              logical,first_stage_mount
odm                             /odm            erofs       ro,barrier=1,discard              logical,first_stage_mount

/dev/block/by-name/metadata     /metadata       ext4        defaults                          wait,first_stage_mount
/dev/block/by-name/userdata     /data           f2fs        noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678    recoveryonly

/dev/block/by-name/misc         /misc           emmc        defaults                          recoveryonly
